# PostgreSQL
POSTGRES_DB=mars_db
POSTGRES_USER=mars_user
POSTGRES_PASSWORD=mars_password
POSTGRES_HOST_PORT=5432

# Backend
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mars_db
SPRING_DATASOURCE_USERNAME=mars_user
SPRING_DATASOURCE_PASSWORD=mars_password
BACKEND_HOST_PORT=8080
MARS_CORS_ALLOWED_ORIGINS=http://localhost:5173
MAIL_ENABLED=true

# Frontend
FRONTEND_HOST_PORT=5173
VITE_API_BASE_URL=/api
